# Copy to apps/api/.env; never commit real values.
DATABASE_URL=postgresql+psycopg://oms:LOCAL_PASSWORD@db:5432/oms
SUPABASE_ISSUER=https://YOUR-PROJECT.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
JWT_AUDIENCE=authenticated
# Fernet.generate_key().decode()
ENCRYPTION_KEY=REPLACE_WITH_REAL_FERNET_KEY
# At least 32 random characters; use your secret manager.
PHONE_HASH_KEY=REPLACE_WITH_LONG_RANDOM_HMAC_SECRET
CORS_ORIGINS=http://localhost:3000
REQUIRE_ADMIN_MFA=true
ENVIRONMENT=development
